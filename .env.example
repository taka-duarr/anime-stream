# =============================================================
# CONTOH ENV — FILE INI AMAN DI-PUSH KE GITHUB ✅
# Salin file ini menjadi ".env" lalu isi nilainya sendiri
# =============================================================

# Anime API Base URL (Sanka Vollerei API)
EXPO_PUBLIC_ANIME_API_BASE_URL=masukkan base endpoint mu wlelele

# Authentication & Bookmark API Base URL
# Ganti dengan URL backend authentication Anda
EXPO_PUBLIC_AUTH_API_BASE_URL=masukkan base endpoint auth mu

# Google Analytics 4 & Google Tag ID (Opsional, khusus Web)
EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
EXPO_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Old Drama API (DEPRECATED - API sudah mati)
# EXPO_PUBLIC_API_BASE_URL=masukkan base endpoint mu wlelele
# EXPO_PUBLIC_NETSHORT_BASE_URL=masukkan base endpoint mu wlelele
